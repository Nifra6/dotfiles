  },
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  }
}
